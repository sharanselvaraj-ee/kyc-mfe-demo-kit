# Copy to .env.local and fill in. Read only by packages/agent — never prefix with VITE_.
ANTHROPIC_API_KEY=

# live | cache | recorded | default (see docs/VERSIONS.md and RT-006)
KYC_AGENT_MODE=live

# claude-haiku-5-5 is the lowest-latency current model (see docs/VERSIONS.md)
KYC_AGENT_MODEL=claude-haiku-5-5
KYC_AGENT_MAX_TOKENS=4096
KYC_AGENT_TIMEOUT_MS=10000

# on | off — serves identical requests from an in-memory cache instead of calling Claude
KYC_AGENT_CACHE=off

KYC_AGENT_PORT=8787
