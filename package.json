{
  "name": "kyc-mfe-demo-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n agent,host -c magenta,cyan \"pnpm --filter @kyc/agent dev\" \"pnpm --filter @kyc/host dev\"",
    "agent:check": "pnpm --filter @kyc/agent check",
    "agent:record": "pnpm --filter @kyc/agent record",
    "lite:bake": "pnpm --filter @kyc/mfe-lite bake",
    "loader:manifest": "pnpm --filter @kyc/loader generate-manifest",
    "ir:build": "pnpm --filter @kyc/ir build",
    "test": "pnpm --filter @kyc/tests test",
    "test:e2e": "pnpm --filter @kyc/tests test:e2e",
    "trace": "pnpm --filter @kyc/tests trace",
    "lint": "eslint .",
    "size": "tsx scripts/size.ts",
    "verify": "pnpm lint && pnpm test && pnpm trace && pnpm size && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "pnpm": "12.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
